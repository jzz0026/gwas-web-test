# Server configuration
PORT=3000

# Docker configuration
DOCKER_CONTAINER=gwas-worker

# SMTP email configuration
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@gwas.local

# Queue concurrency and demo delay settings
MAX_CONCURRENT_TASKS=2
PROCESSING_DELAY_MS=3000
BASE_URL=http://localhost:3000

# Runner image (used per task)
GWAS_RUNNER_IMAGE=gwas-worker:latest
