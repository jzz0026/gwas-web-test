# 服务器配置
PORT=3000

# Docker 配置
DOCKER_CONTAINER=gwas-worker

# SMTP 邮件配置
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@gwas.local

# 队列并发和演示延迟配置
MAX_CONCURRENT_TASKS=2
PROCESSING_DELAY_MS=3000
BASE_URL=http://localhost:3000

# 独立 runner 容器镜像（按任务运行）
GWAS_RUNNER_IMAGE=ubuntu:22.04
